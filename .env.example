# Copy to .env (gitignored) next to this file. Never commit the real .env.

# Encryption key for saved broker passwords (32 random bytes, base64).
# Make one with:  cd backend && python -m mohz.keygen
# Keep a backup: without it the saved broker passwords cannot be read.
MOHZ_BROKER_KEY=

# Database. Leave empty for SQLite in data/mohz.db (development).
# Production: postgresql+psycopg://mohz:PASSWORD@127.0.0.1:5432/mohz
MOHZ_DATABASE_URL=

# mt5 = real MetaTrader 5 terminals (Windows). fake = simulated broker (development).
MOHZ_CONNECTOR=mt5
# A clean portable MetaTrader 5 folder (with terminal64.exe). Copied once per broker account.
MOHZ_MT5_TEMPLATE_DIR=C:\mohz\mt5-template
# Where the per-account terminal copies live (default data/terminals)
MOHZ_TERMINALS_DIR=
# Spare terminals for login checks and the Detect button
MOHZ_PROBE_SLOTS=2

# Cookies need HTTPS. Set false only for local development over http://localhost.
MOHZ_COOKIE_SECURE=true
# true when behind Caddy/nginx on the same machine (rate limits use X-Forwarded-For)
MOHZ_TRUST_PROXY=true

# Telegram alerts (optional): a bot from @BotFather, its username, and a random webhook secret
MOHZ_TELEGRAM_BOT_TOKEN=
MOHZ_TELEGRAM_BOT_USERNAME=
MOHZ_TELEGRAM_WEBHOOK_SECRET=
